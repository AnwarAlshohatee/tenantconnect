<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | TenantConnect</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Navigation -->
  <nav class="navbar bg-white border-bottom shadow-sm">
    <div class="container">

      <a href="/dashboard" class="navbar-brand text-primary">
        TenantConnect
      </a>

      <form action="/logout" method="POST" class="m-0">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
          Logout
        </button>
      </form>

    </div>
  </nav>

  <main class="container py-5">

    <!-- Welcome section -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4 p-md-5">

        <p class="text-primary fw-semibold mb-2">
          BUILDING DASHBOARD
        </p>

        <h1 class="fw-bold mb-3">
          Welcome back, <%= user.name %>!
        </h1>

        <p class="text-muted mb-2">
          Building: <strong><%= user.building %></strong>
        </p>

        <p class="text-muted mb-4">
          Stay connected with your neighbors and upcoming meetings.
        </p>

        <a href="/meetings/new" class="btn btn-primary">
          + Create Meeting
        </a>

      </div>
    </div>

    <!-- Meetings heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <h2 class="h4 fw-bold mb-0">Building Meetings</h2>

      <span class="badge bg-primary-subtle text-primary">
        <%= meetings.length %> Meetings
      </span>
    </div>

    <!-- Empty state -->
    <% if (meetings.length === 0) { %>

      <div class="card border-0 shadow-sm">
        <div class="card-body text-center p-5">

          <h3 class="h5">No meetings scheduled yet</h3>

          <p class="text-muted">
            Be the first to organize a meeting for your building.
          </p>

          <a href="/meetings/new" class="btn btn-primary">
            Create Your First Meeting
          </a>

        </div>
      </div>

    <% } %>

    <!-- Responsive meeting cards -->
    <div class="row g-4">

      <% meetings.forEach(meeting => { %>

        <div class="col-12 col-md-6">

          <div class="card h-100 shadow-sm">

            <div class="card-body p-4">

              <h3 class="h5 fw-bold mb-3">
                <%= meeting.title %>
              </h3>

              <p class="text-muted">
                <%= meeting.description %>
              </p>

              <hr>

              <p class="small mb-2">
                <strong>Date:</strong>
                <%= new Date(meeting.date).toLocaleString() %>
              </p>

              <p class="small mb-2">
                <strong>Location:</strong>
                <%= meeting.location %>
              </p>

              <p class="small text-muted">
                Created by:
                <%= meeting.createdBy?.name || "Unknown" %>
              </p>

              <!-- Only the creator can edit or delete -->
              <% if (
                meeting.createdBy &&
                meeting.createdBy._id.toString() === user._id.toString()
              ) { %>

                <div class="d-flex gap-2 flex-wrap mt-3">

                  <a
                    href="/meetings/<%= meeting._id %>/edit"
                    class="btn btn-outline-primary btn-sm"
                  >
                    Edit Meeting
                  </a>

                  <form
                    action="/meetings/<%= meeting._id %>/delete"
                    method="POST"
                    class="m-0"
                  >
                    <button
                      type="submit"
                      class="btn btn-outline-danger btn-sm"
                      onclick="return confirm('Delete this meeting?')"
                    >
                      Delete
                    </button>
                  </form>

                </div>

              <% } %>

            </div>
          </div>
        </div>

      <% }) %>

    </div>

  </main>

</body>
</html>